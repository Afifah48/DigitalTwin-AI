# ===============================================
# DigitalTwin-AI Configuration
# ===============================================

# [Frontend] API Base URL
# Leave blank when deploying frontend & backend on the same origin / container
# Or set to your backend deployment URL, e.g. https://api.digitaltwin.example.com
VITE_API_BASE_URL=""

# [Backend / Server] Port configuration
PORT=8000

# [Backend] Allowed CORS Origins (comma-separated or * for all)
ALLOWED_ORIGINS="*"

# [Node Server Proxy] Backend URL if using Node server.js
BACKEND_URL="http://127.0.0.1:8000"

# Optional Gemini API Key
GEMINI_API_KEY=""

