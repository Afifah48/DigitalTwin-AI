{
    "services": {
        "frontend": {
            "root": ".",
            "framework": "vite"
        },
       "backend": {
             "root": "backend",
             "entrypoint": "api.main:app"
       }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
